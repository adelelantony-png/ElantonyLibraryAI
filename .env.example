# ==============================================================================
# ELANTONY LIBRARY AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Rename this file to .env and fill in your actual private credentials.
# NEVER commit or expose the .env file.
# ==============================================================================

# Application Environment (development / production / staging)
APP_ENV=development
APP_NAME="ELANTONY LIBRARY AI"
APP_PORT=8000
APP_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 1. Telegram Bot Credentials
# ------------------------------------------------------------------------------
# Obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Mode: "polling" (recommended for development & simple cloud) or "webhook"
TELEGRAM_MODE=polling

# Webhook domain (required only if TELEGRAM_MODE=webhook)
# E.g.: https://library.yourdomain.com
TELEGRAM_WEBHOOK_URL=

# Secret token to validate incoming webhook updates from Telegram
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 2. Access Control & Authorization (User ID Whitelist)
# ------------------------------------------------------------------------------
# Comma-separated list of Telegram User IDs allowed to use the bot
# Use @userinfobot on Telegram to get your numeric user ID
ALLOWED_TELEGRAM_USER_IDS=

# Comma-separated list of Admin Telegram User IDs (can manage users & trigger scans)
ADMIN_TELEGRAM_USER_IDS=

# Rate Limit: Max requests per user per minute
RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------------------------
# 3. Database Configuration
# ------------------------------------------------------------------------------
# Local SQLite path (default)
DATABASE_URL=sqlite:///file_archive.db

# Production PostgreSQL URL (uncomment for cloud deployment)
# DATABASE_URL=postgresql+asyncpg://elantony_user:strong_password@postgres:5432/elantony_library

# ------------------------------------------------------------------------------
# 4. Storage Providers Configuration
# ------------------------------------------------------------------------------
# Primary storage provider: local / telegram_channel / onedrive / unlimcloud
DEFAULT_STORAGE_PROVIDER=local

# Telegram Private Channel Storage (for cloud file hosting)
TELEGRAM_STORAGE_CHANNEL_ID=

# Microsoft OneDrive Configuration (Graph API)
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=
ONEDRIVE_ROOT_FOLDER=ElantonyLibrary

# UnlimCloud Storage (Experimental)
UNLIMCLOUD_API_KEY=
UNLIMCLOUD_ENDPOINT=

# ------------------------------------------------------------------------------
# 5. AI & LLM Provider Configuration
# ------------------------------------------------------------------------------
# AI Provider: rule_based / gemini / ollama / groq
AI_PROVIDER=rule_based

# Google Gemini API Key (Optional)
GEMINI_API_KEY=

# Local Ollama / LLaMA.cpp Host (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Groq API Key (Optional)
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 6. OCR & Resource Management
# ------------------------------------------------------------------------------
TESSERACT_CMD=
MAX_MEMORY_MB=600
OCR_DPI=150
